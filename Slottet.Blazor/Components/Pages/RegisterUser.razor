@page "/registerUser"


@* Form til login *@
<div class="registerForm">
	<form>
		<div class="formGroup">

			<div>
				<label for="username"> <b>Brugernavn</b> </label>
			</div>

			<div>
				<input type="text" placeholder="Indtast Brugernavn" name="username" required />
			</div>

		</div>

		<div class="formGroup">

			<div>
				<label for="password"><b>Kodeord</b></label>
			</div>

			<div>
				<input type="password" placeholder="Indtast Ønsket Kodeord" name="password" required>
			</div>
		</div>
		<div class="formGroup">

			<div>
				<label for="role"><b>Rolle</b></label>
			</div>

			<div>
				<input type="role" placeholder="Indtast Rolle Her" name="role" required>
			</div>



		</div>
		<div class="formGroup">
			<button type="submit" class="registerButton">Opret Bruger</button>
		</div>
	</form>
</div>
