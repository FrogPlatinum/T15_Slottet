@page "/registerUser"
@using Slottet.Shared.DTOs
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject HttpClient Http

@* Form for register *@
<div class="registerForm">
	<form>
		<div class="formGroup">

			<div>
				<label for="username"> <b>Brugernavn</b> </label>
			</div>

			<div>
				<input type="text" placeholder="Indtast Brugernavn" name="username" required @bind-value="newUser.Username"/>
			</div>

		</div>

		<div class="formGroup">

			<div>
				<label for="password"><b>Kodeord</b></label>
			</div>

			<div>
				<input type="password" placeholder="Indtast Ønsket Kodeord" name="password" required @bind-value="newUser.Password"/>
			</div>
		</div>
		<div class="formGroup">

			<div>
				<label for="role"><b>Rolle</b></label>
			</div>

			<div>
				<input type="role" placeholder="Indtast Rolle" name="role" required @bind-value="newUser.Role"/>
			</div>



		</div>
		<div class="formGroup">
			<button type="submit" class="registerButton" @onclick="CreateUser" >Opret Bruger</button>
		</div>
	</form>
	<div class="formGroup">
		<button class="registerButton" @onclick="NavigateToDashboard">Gå til Driftstavlen</button>
	</div>
</div>
@code {

	private UserDto newUser = new();

	private void NavigateToDashboard()
	{
		Navigation.NavigateTo("/dashboard");
	}
	
	private async Task CreateUser()
	{	
		var response = await Http.PostAsJsonAsync("api/Auth/register", newUser);
		if(response.IsSuccessStatusCode)
		{
			newUser = new UserDto();
		}
	}
}
