@page "/"
@using Slottet.Shared.DTOs
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JS

@* Form til login *@
<div class="loginForm">
<form>
	<div class="formGroup">

	<div>
	<label for="username"> <b>Brugernavn</b> </label>
	</div>

	<div>
	<input type="text" placeholder="Indtast Brugernavn" name="username" @bind-value="loginUser.Username" required />
	</div>

	</div>

	<div class="formGroup">

	<div>
	<label for="password"><b>Kodeord</b></label>
	</div>

	<div>
	<input type="password" placeholder="Indtast Kodeord" name="password" @bind-value="loginUser.Password" required>
	</div>

	</div>
	<div class="formGroup">
	<button type="submit" class="loginButton" @onclick="LoginUser" >Log Ind</button>
	</div>
		
</form>
	<div class="formGroup">
		<button class="loginButton" @onclick="NavigateToDashboard">Gå til Driftstavlen</button>
	</div>
</div>
@code {

	private UserDto loginUser = new();

	private void NavigateToDashboard()
	{
		Navigation.NavigateTo("/dashboard");
	}

	private async Task LoginUser()
	{
		var response = await Http.PostAsJsonAsync("api/Auth/login", loginUser);

		if (!response.IsSuccessStatusCode)
		{
			return;
		}

		var token = await response.Content.ReadAsStringAsync();

		await JS.InvokeVoidAsync("localStorage.setItem", "authToken", token);

		NavigateToDashboard();
	}
}
