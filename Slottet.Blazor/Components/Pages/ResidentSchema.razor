@using Slottet.Shared.DTOs.ResidentSchema
@using Slottet.Shared.DTOs.MedicinStatus
@inject HttpClient Http
@inject IJSRuntime JS
@page "/residentschema"
@rendermode InteractiveServer

	
		<!--
	Step 1
	Tilføj bokse

	Step 2
	Sørg for at oplysningerne er fra database

	Step 3
	Tilføj CSS kode med borders og linjeafstand

	Step 4
	Tilføj de andre bokse

	Step 5
	Make it pretty
	-->

		<h1>Alle Borgerfelter</h1>
	<div class="allSchemas">
		
@foreach (var schema in _schemas)
{
<div class="individualSchemas">

			<table style="width:100%">
				
				@* Resident "Name" *@
				
				<tr>
					<th colspan="10" class="Name"><h2>@schema.Name</h2></th>
				</tr>
				
				

				@* Traffic Light *@
				<tr>
					<th colspan="10">Status(trafik)</th>
				</tr>
				
				 <!--Hvor bestemmes dette? - Hvor bliver dette angivet?-->
				<tr>
				<td>@schema.TrafficLight</td>
				@* <td class="trafficred">rød</td>
				<td class="trafficyellow">gul</td>
				<td class ="trafficgreen">grøn</td> *@

					@* <InputSelect @bind-Value="@schema.TrafficLight">

						@foreach (var trafficLight in Enum.GetValues(typeof(ResidentSchemaDto.TrafficLightStatus.TrafficLight)))
						{

							<option value="@trafficLight">@trafficLight</option>
						}
					</InputSelect> *@
				</tr>

				@* Medicine Status *@
				<tr>
					<th colspan="10">Medicintider</th>
	
				</tr>
		
				<tr>
					@foreach (var status in _statuses)
					{
						@if (schema.Id == status.ResidentSchemaId)
						{
					<td>
								<div>
						@status.Time.ToString("HH:mm")
					

								</div>
								<div>
					<input type="checkbox" @bind="status.Administered"/> 
					
								</div>
							</td>
		
					}
	}
				
			</tr>

				@* Employees *@	

				<tr>
					<th colspan="10">Personale</th>
				</tr>
				<tr>
					<td>@schema.Employee</td> <!-- 2 medarbejdere-->

				</tr>
				@* Notes *@	
				
				<tr>
					<th colspan="10">Note</th>
				</tr>
				<tr>
					<td colspan="10">@schema.Note</td>
				</tr>
				
			</table>

			<button class="btn btn-sm btn-danger" @onclick="()=>DeleteSchema(schema.Id, schema.Name)"> Slet Borgerfelt</button>
		</div>
	}
		

		@* Add Button *@	
		@* <button class="addSchemaButton" @onclick="ShowAddNewSchemaForm"> Tilføj Borgerfelt </button> *@
	<div class="newSchema"> 
		@* Name*@
		<label> Borger Initialer:</label>
		<input class="form-control" @bind="newSchema.Name"/>
		@* Traffic light? Maybe we don't need this in the create form?*@
		<label class="mt-2">Trafiklys</label>
		<select class="form-control-color" @bind="newSchema.TrafficLight">
		
			
			<option value="Green">Grøn</option>
			<option value="Yellow">Gul</option>
			<option value="Red">Rød</option>
		</select>
		@* Medicine Time? I'll wait with this one.. I might have an idea for adding times!*@
		@* <label></label>
		<label class="mt-2"></label> *@
		@* Employeee Section *@
		<label> Medarbejder:</label>
		<input class="form-control" @bind="newSchema.Employee" />
		@*Note*@
		<label> Note:</label>
		<input class="form-control" @bind="newSchema.Note" />
		<button type="button" class="btn btn-primary mt-3" @onclick="AddNewSchema">Tilføj Borger</button>
	</div>
	</div>

@code {
	// Resident Schema
	private ResidentSchemaDto[] _schemas = Array.Empty<ResidentSchemaDto>();


	public async Task GetAllResidentSchemas()
	{
		_schemas = await Http.GetFromJsonAsync<ResidentSchemaDto[]>("api/ResidentSchema/allschemas") ?? Array.Empty<ResidentSchemaDto>();
	}
	// private List<ResidentSchemaDto> _schemas = new List<ResidentSchemaDto>;
	// public async Task GetAllResidentSchemas()
	// {
	// 	_schemas = await Http.GetFromJsonAsync<List<ResidentSchemaDto>>("api/ResidentSchema/allschemas");
	// }
	//Medicine Status

	private MedicineStatusDto[] _statuses = Array.Empty<MedicineStatusDto>();

	public async Task GetAllMedicineStatuses()
	{
		_statuses = await Http.GetFromJsonAsync<MedicineStatusDto[]>("api/MedicineStatus/allstatuses") ?? Array.Empty<MedicineStatusDto>();
	}

	//All together :)
	protected override async Task OnInitializedAsync()
	{
		await GetAllResidentSchemas();
		await GetAllMedicineStatuses();
	}

	private ResidentSchemaDto newSchema = new();
	// private List<ResidentSchemaDto> schemas = new();
	//Add empty residentSchema
	private async Task CreateAsync()
	{

		if (!string.IsNullOrWhiteSpace(newSchema.Name))
		{ 
			var response = await Http.PostAsJsonAsync("api/ResidentSchema/AddAsync", newSchema); 
			if (response.IsSuccessStatusCode)
			{
				await GetAllResidentSchemas();
				newSchema = new ResidentSchemaDto();
			}
		}

	}
	// public async Task DeleteAsync()
	// {
	// 	_statuses = await Http.DeleteFromJsonAsync("api/ResidentSchema/");
	// }

	private async Task AddNewSchema(MouseEventArgs args)
	{
		await CreateAsync();
	}
	private async Task DeleteSchema(int id, string name)
	{

		var confirmed = await JS.InvokeAsync<bool>("confirm", $"Er du sikker på du vil slette borgerfeltet tilhørende {name}?");
		if (!confirmed)
			return;

		var response = await Http.DeleteAsync($"api/ResidentSchema/{id}");

		if (response.IsSuccessStatusCode)
		{
			await GetAllResidentSchemas();
		}
	}
}
