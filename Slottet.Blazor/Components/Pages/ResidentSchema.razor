				</tr>
				
				 <!--Hvor bestemmes dette? - Hvor bliver dette angivet?-->
				<tr>

					<td>@schema.TrafficLight</td>

				@* 	@switch (ActiveColor)
					{
					case 1:

					ActiveColor =Grøn;


					break;
					case 2:
							ActiveColor = Grøn;

					break;
					case "3":

							ActiveColor = schema.TrafficLight.Grøn;

					break;

		}
						 *@
