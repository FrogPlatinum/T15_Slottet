								</div>
							</td>
		
					}
	}
				
			</tr>

				@* Employees	

				<tr>
					<th colspan="10">Personale</th>
				</tr>
				<tr>
					<td>@schema.Employee</td> <!-- 2 medarbejdere-->

				</tr>
				@* Notes *@	
				
				<tr>
					<th colspan="10">Note</th>
				</tr>
				<tr>
					<td colspan="10">@schema.Note</td>
				</tr>
				
			</table>
		</div>
	}
		<div class="individualSchemas">

			<table style="width:100%">
				
				@* Resident "Name" *@
				
				<tr>
					<th colspan="10" class="Name"><h2>Tomt</h2></th>
				</tr>
				
				

				@* Traffic Light *@
				<tr>
					<th colspan="10">Status(trafik)</th>
				</tr>
				
				 <!--Hvor bestemmes dette? - Hvor bliver dette angivet?-->
				<tr>
				<td class="trafficRed">Rød</td>
				<td class="trafficYellow">Gul</td>
				<td class ="trafficGreen">Grøn</td>
				</tr>

				@* Medicine Status *@
				<tr>
					<th colspan="10">Medicintider</th>
	
				</tr>
		
				<tr>
					<td>tid</td>
					@* @foreach (var status in _statuses)
					{
						@if (schema.Id == status.ResidentSchemaId)
						{
					<td>
								<div>
						@status.Time.ToString("HH:mm")
					

								</div>
								<div>
					<input type="checkbox" @bind="status.Administered"/> 
					
								</div>
							</td>
		
					}
	} *@
				
			</tr>

				@* Employees *@	

				<tr>
					<th colspan="10">Personale</th>
				</tr>
				<tr>
					<td>Tom</td> <!-- 2 medarbejdere-->

				</tr>
				@* Notes *@	
				
				<tr>
					<th colspan="10">Note</th>
				</tr>
				<tr>
					<td colspan="10">Skriv note her</td>
				</tr>
				
			</table>
		</div>

		@* Add Button *@	
		<button class="addSchemaButton" @onclick="AddNewSchema"> Tilføj Borgerfelt </button>
	
	</div>



@code {
	//Resident Schema
	private ResidentSchemaDto[] _schemas = Array.Empty<ResidentSchemaDto>();

	public async Task GetAllResidentSchemas()
	{
		_schemas = await Http.GetFromJsonAsync<ResidentSchemaDto[]>("api/ResidentSchema/allschemas") ?? Array.Empty<ResidentSchemaDto>();
	}


	//Medicine Status

	private MedicineStatusDto[] _statuses = Array.Empty<MedicineStatusDto>();

	public async Task GetAllMedicineStatuses()
	{
		_statuses = await Http.GetFromJsonAsync<MedicineStatusDto[]>("api/MedicineStatus/allstatuses") ?? Array.Empty<MedicineStatusDto>();
	}

	//All together :)
	protected override async Task OnInitializedAsync()
	{
		await GetAllResidentSchemas();
		await GetAllMedicineStatuses();
	}

	private ResidentSchemaDto newSchema = new();
	private List<ResidentSchemaDto> schemas = new();
	//Add empty residentSchema
	public async Task CreateAsync()
	{

		var response = await Http.PostAsJsonAsync("api/ResidentSchema/AddAsync", newSchema);
		var createdSchema = await response.Content.ReadFromJsonAsync<ResidentSchemaDto>();
		schemas.Add(createdSchema);

	}


	private async Task AddNewSchema(MouseEventArgs args)
	{
		await CreateAsync();
	}
	public bool IsActive { get; set; }

	public string ActiveColor { get; set; }
	private async Task ChangeActiveLight (MouseEventArgs args)
	{
		
	}
	}
